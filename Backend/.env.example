# Copy to Backend/.env and fill in. .env is ignored by git; never commit real values.
# Generate any secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | production. "production" refuses to boot on a weak configuration
# (short JWT secret, no database TLS, http CORS origins, docs switched on).
APP_ENV=development

DATABASE_URL=postgresql+psycopg://gyansankalp_app:CHANGE_ME@localhost:5433/gyansankalp
# In production add TLS: ?sslmode=require (or verify-full) - the app enforces it.

JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
# Signs admin tokens only, and must differ from JWT_SECRET. Keeping the two apart
# means a leaked student-token secret cannot be used to mint an admin token.
ADMIN_JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# true only when a reverse proxy in front of uvicorn sets X-Forwarded-For.
# Leaving it false while behind a proxy puts every visitor in one IP bucket.
TRUST_FORWARDED_FOR=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=gyansankalp-private
S3_REGION=us-east-1
# Development convenience only: creates the bucket on startup. Keep false in production.
S3_CREATE_BUCKET=true

MAX_UPLOAD_MB=50
MAX_PDF_PAGES=800

# Where the conversion worker answers HTTP. Only needed when the worker is a
# Render/Coolify service that sleeps: after an upload the API sends one GET here
# so a fresh PDF does not sit pending until something else wakes the worker.
# Leave unset when the worker runs permanently (a terminal, compose, a VM).
# WORKER_URL=https://gyansankalp-worker.onrender.com/healthz

# Comma-separated. Must be https origins when APP_ENV=production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Google sign-in, used by students and by staff. For staff it is the only way in:
# the password form is gone. Leave unset and /auth/google answers 503 while
# /admin/auth/google answers 503 too, so a server without it cannot be signed into
# as staff at all. The value comes from Google Cloud Console
# (OAuth consent screen -> Credentials -> OAuth client ID, type "Web application");
# it is public text, not a secret, and the browser uses the same value.
# Authorize the redirect page origin there; no redirect URI is needed for the
# ID-token flow this app uses. Add each staff Gmail under Audience -> Test users
# while the OAuth app is still in "External" testing mode.
# GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs

# Verification email and staff sign-in codes. Password signups must confirm their
# address before they can enroll; a Google sign-in confirms it while linking, because
# Google only signs a token for an address it has already verified. Every staff login
# mails a six digit code here.
# With SMTP_HOST unset the message is printed to the log instead of sent - handy in
# development, refused when APP_ENV=production. The code itself is never logged in
# production, and never returned in an API response.
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=587
# SMTP_USERNAME=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# SMTP_USE_TLS=true
# MAIL_FROM="GyanSankalp <no-reply@example.com>"
# Render's free tier blocks outbound SMTP on ports 25, 465 and 587, so a deployed
# API cannot reach an SMTP server at all. This sends the same two messages over
# HTTPS instead. Set, it wins over the SMTP settings above; leave it unset locally
# and plain SMTP keeps working from your machine.
# BREVO_API_KEY=xkeysib-CHANGE_ME
# The SPA page that reads ?token= and calls /auth/verify-email.
# VERIFY_LINK_BASE=http://localhost:5173/verify-email
EMAIL_VERIFY_HOURS=24

# /docs, /redoc and /openapi.json. False in production - they describe every
# route and every field name to anyone who asks.
EXPOSE_DOCS=true

# Set true only when the API is served over HTTPS end to end, otherwise the
# header is ignored by browsers and can lock people out of an http site.
HSTS_ENABLED=false

# Staff sign-in timings. The defaults are the shipped policy: a code lives five
# minutes, survives five wrong tries, can be re-sent after a minute, and the
# session renews for a working day without mailing another code.
# ADMIN_OTP_MINUTES=5
# ADMIN_OTP_MAX_ATTEMPTS=5
# ADMIN_OTP_RESEND_SECONDS=60
# ADMIN_OTP_CHALLENGE_MINUTES=10
# ADMIN_ACCESS_TOKEN_MINUTES=15
# ADMIN_REFRESH_TOKEN_DAYS=1
# ADMIN_ACTIVITY_LOG_DAYS=365

# The staff roster is seeded from here and then lives as database rows.
# Comma-separated "email:Full Name:role" entries, where role is super_admin,
# content_manager or editor. These are the only addresses the admin door accepts,
# which is why they belong in .env and not in the repository. Seed once, after
# `alembic upgrade head`:
#   python -m app.scripts.seed_staff
# After that, Super Admins add, promote and deactivate people from the panel.
# There is no public staff registration.
# STAFF_ROSTER=you@example.com:Your Name:super_admin, them@example.com:Their Name:editor
