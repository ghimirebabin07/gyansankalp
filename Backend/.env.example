# Copy to Backend/.env and fill in. .env is ignored by git; never commit real values.
# Generate any secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# development | production. "production" refuses to boot on a weak configuration
# (short JWT secret, no database TLS, http CORS origins, docs switched on).
APP_ENV=development

DATABASE_URL=postgresql+psycopg://gyansankalp_app:CHANGE_ME@localhost:5433/gyansankalp
# In production add TLS: ?sslmode=require (or verify-full) - the app enforces it.

JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# true only when a reverse proxy in front of uvicorn sets X-Forwarded-For.
# Leaving it false while behind a proxy puts every visitor in one IP bucket.
TRUST_FORWARDED_FOR=false

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

DB_POOL_SIZE=10
DB_POOL_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT_SECONDS=5

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=gyansankalp-private
S3_REGION=us-east-1
# Development convenience only: creates the bucket on startup. Keep false in production.
S3_CREATE_BUCKET=true

MAX_UPLOAD_MB=50
MAX_PDF_PAGES=800

# Comma-separated. Must be https origins when APP_ENV=production.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# /docs, /redoc and /openapi.json. False in production - they describe every
# route and every field name to anyone who asks.
EXPOSE_DOCS=true

# Set true only when the API is served over HTTPS end to end, otherwise the
# header is ignored by browsers and can lock people out of an http site.
HSTS_ENABLED=false

# One-time admin bootstrap. Remove these three lines as soon as the account
# exists - the app prints a security error and exits when they are set and an admin
# exists already.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=CHANGE_ME_LONG_AND_RANDOM (12 characters minimum)
# INITIAL_ADMIN_NAME=Site Admin
