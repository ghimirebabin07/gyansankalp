# Frontend build-time configuration. Vite reads these when it bundles the app,
# so a value that is missing here is missing from the deployed site as well -
# the bundle cannot be fixed later without rebuilding it.
#
# Cloudflare Pages builds `main` and takes the three values from
# Settings -> Environment & Variables. Keep this file and that list identical.

# Where the browser sends every API call.
# Local development against `docker compose up`:
#   VITE_API_URL=http://localhost:8000
VITE_API_URL=https://gyansankalp-api.onrender.com

# The conversion worker's health URL. Rendering a PDF only happens inside the
# worker, and a free Render service sleeps after 15 idle minutes; from inside
# the platform the API cannot wake it, because the hostname resolves to a
# private address with nothing listening. So the admin panel requests this URL
# itself when it queues a job. Unset means uploads queue and nothing converts
# them until the worker wakes on its own.
#
# Leave it unset for local development: the worker only opens its health port
# when PORT is set, which is Render's variable, so a locally run worker has
# nothing to answer this request.
VITE_WORKER_URL=https://gyansankalp-worker.onrender.com/healthz

# Google sign-in. Must equal GOOGLE_CLIENT_ID on the API, or the ID token the
# button hands over fails its audience check and sign-in refuses to work.
# Copy the value from Backend/.env; it is not listed here because this
# repository is public.
VITE_GOOGLE_CLIENT_ID=
